# Settings. On Netlify, set them under Project configuration > Environment variables.
# Locally, pass them on the command line (see README, "Try it on your own computer").
# Never write the real password or secret key into this file or anywhere else in the repository.

# Required. The password people type to submit an answer. Secret: set it only in Netlify.
# Without it, every answer is refused.
POLL_PASSWORD=change-me

# Required. Cloudflare Turnstile, the human check (free): create a widget at
# dash.cloudflare.com > Turnstile for your site's hostname. The site key is public;
# the secret key is secret: set it only in Netlify. Without them, no poll can be created
# and every answer is refused.
# Locally, use Cloudflare's test keys, which always pass:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# Time zone that decides what "today" is and when a week ends.
POLL_TZ=Europe/Budapest
